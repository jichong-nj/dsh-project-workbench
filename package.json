{
  "name": "@jichong/dsh-project-workbench",
  "version": "0.14.5",
  "description": "Project → Task personal workbench for DeepSeek Harness Web: two-level projects/tasks, derived needs-you column, layered AGENTS.md skeletons and an HTTP-backed kanban UI",
  "license": "MIT",
  "author": "jichong-nj",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "project",
    "task",
    "workbench",
    "kanban",
    "agents-md",
    "工作台",
    "项目管理"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CONTRACTS.md",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "check": "node --check index.js && node --check client.js && node test/run-all.mjs",
    "ui-verify": "node test/ui-verify.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jichong-nj/dsh-project-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/jichong-nj/dsh-project-workbench/issues"
  },
  "homepage": "https://github.com/jichong-nj/dsh-project-workbench#readme"
}
